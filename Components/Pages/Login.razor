@page "/login"
@inject IMailcowAuthService MailcowAuth
@inject UserSessionService UserSession
@inject NavigationManager Navigation

<PageTitle>Login Mailcow - BaknusITCare</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="fluent-card shadow-lg p-4 p-md-5 bg-white rounded-4 border-0">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary mb-3">
                        <i class="bi bi-shield-lock-fill fs-1"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">BaknusITCare</h3>
                    <p class="text-secondary small mb-2">Layanan IT Terpadu SMK Bakti Nusantara 666</p>
                    <div class="d-flex flex-wrap justify-content-center gap-1">
                        <span class="badge bg-primary bg-opacity-10 text-primary border px-2 py-1 rounded-pill small">
                            <i class="bi bi-tag-fill me-1"></i>TAG: Siswa
                        </span>
                        <span class="badge bg-success bg-opacity-10 text-success border px-2 py-1 rounded-pill small">
                            <i class="bi bi-tag-fill me-1"></i>TAG: Guru
                        </span>
                        <span class="badge bg-info bg-opacity-10 text-info border px-2 py-1 rounded-pill small">
                            <i class="bi bi-tag-fill me-1"></i>TAG: TU
                        </span>
                        <span class="badge bg-danger bg-opacity-10 text-danger border px-2 py-1 rounded-pill small">
                            <i class="bi bi-shield-fill-check me-1"></i>TAG: Admin
                        </span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center rounded-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 flex-shrink-0"></i>
                        <div>@ErrorMessage</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(SuccessMessage))
                {
                    <div class="alert alert-success d-flex align-items-center rounded-3 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill fs-4 me-3 flex-shrink-0"></i>
                        <div>@SuccessMessage</div>
                    </div>
                }

                <EditForm Model="LoginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted">Email Mailcow Sekolah</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                            <InputText @bind-Value="LoginModel.Email" class="form-control bg-light border-start-0" placeholder="contoh: nama@smk.baktinusantara666.sch.id" />
                        </div>
                        <ValidationMessage For="() => LoginModel.Email" class="text-danger small" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-muted">Password Mailcow</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key"></i></span>
                            <InputText @bind-Value="LoginModel.Password" type="password" class="form-control bg-light border-start-0" placeholder="Masukkan password email Anda" />
                        </div>
                        <ValidationMessage For="() => LoginModel.Password" class="text-danger small" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm d-flex align-items-center justify-content-center" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Memverifikasi Mailcow TAG...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right me-2 fs-5"></i>
                            <span>Masuk ke Sistem IT</span>
                        }
                    </button>
                </EditForm>

                <div class="mt-4 pt-3 border-top text-center">
                    <span class="text-muted small fw-semibold d-block mb-2">Login Cepat Akun Demo (Sesuai TAG):</span>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick='() => QuickLogin("admin@smk.baktinusantara666.sch.id", "buhun666")'>
                            <i class="bi bi-shield-lock me-1"></i> Admin IT
                        </button>
                        <button class="btn btn-sm btn-outline-success rounded-pill" @onclick='() => QuickLogin("guru.pplg@smk.baktinusantara666.sch.id", "BaknusMail123!")'>
                            <i class="bi bi-person-video3 me-1"></i> Guru
                        </button>
                        <button class="btn btn-sm btn-outline-info rounded-pill" @onclick='() => QuickLogin("tu.staff@smk.baktinusantara666.sch.id", "BaknusMail123!")'>
                            <i class="bi bi-file-earmark-person me-1"></i> Staf TU
                        </button>
                        <button class="btn btn-sm btn-outline-primary rounded-pill" @onclick='() => QuickLogin("siswa.pplg@smk.baktinusantara666.sch.id", "BaknusMail123!")'>
                            <i class="bi bi-mortarboard me-1"></i> Siswa
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginViewModel LoginModel = new();
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsLoading = false;

    protected override void OnInitialized()
    {
        if (UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("");
        }
    }

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var result = await MailcowAuth.AuthenticateUserAsync(LoginModel.Email, LoginModel.Password);
            
            if (result.Success && result.User != null)
            {
                UserSession.SetUser(result.User);
                Navigation.NavigateTo("");
            }
            else
            {
                ErrorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Terjadi kendala saat login: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task QuickLogin(string email, string pass)
    {
        LoginModel.Email = email;
        LoginModel.Password = pass;
        await HandleLogin();
    }

    public class LoginViewModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email Mailcow wajib diisi.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Format email tidak valid.")]
        public string Email { get; set; } = "admin@smk.baktinusantara666.sch.id";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password wajib diisi.")]
        public string Password { get; set; } = "buhun666";
    }
}
