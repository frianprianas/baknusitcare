@page "/Error"
@using System.Diagnostics

<PageTitle>Error - BaknusITCare</PageTitle>

<div class="container mt-5 text-center">
    <div class="fluent-card p-5 mx-auto" style="max-width: 600px; border-top: 4px solid var(--fluent-danger);">
        <i class="bi bi-exclamation-triangle-fill text-danger display-1 mb-3"></i>
        <h2 class="fw-bold text-dark mb-2">Terjadi Kesalahan Server</h2>
        <p class="text-muted mb-4">Sistem BaknusITCare mengalami masalah saat memproses permintaan Anda.</p>
        
        @if (ShowRequestId)
        {
            <div class="alert alert-light border text-start mb-4">
                <small class="text-muted d-block">Request ID:</small>
                <code>@RequestId</code>
            </div>
        }

        <a href="/" class="btn fluent-btn-primary px-4">
            <i class="bi bi-house-door me-2"></i>Kembali ke Beranda
        </a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
