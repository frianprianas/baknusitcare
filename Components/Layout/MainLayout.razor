@inherits LayoutComponentBase
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@implements IDisposable

@if (IsAuthPage)
{
    <!-- Standalone View for Login / Error Page -->
    <main class="min-vh-100 bg-light d-flex flex-column justify-content-center">
        @Body
    </main>
}
else if (UserSession.IsLoggedIn)
{
    <!-- Authenticated Layout with Header, Sidebar, & App Content -->
    <div class="d-flex flex-column min-vh-100">
        <!-- Microsoft Fluent Top Header -->
        <header class="fluent-header sticky-top">
            <div class="fluent-brand">
                <i class="bi bi-headset fs-3 text-warning"></i>
                <div>
                    <span class="fw-bold">BaknusITCare</span>
                    <span class="fluent-brand-badge ms-2">Full Microsoft Stack</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a href="tickets/create" class="btn btn-warning text-dark fw-bold btn-sm rounded-pill px-3 shadow-sm d-none d-md-inline-block">
                    <i class="bi bi-plus-lg me-1"></i> Buat Tiket Masalah
                </a>
                
                <div class="dropdown">
                    <button class="btn btn-light btn-sm rounded-pill px-3 d-flex align-items-center gap-2 border-0 shadow-sm" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-fill text-primary"></i>
                        <span class="fw-semibold d-none d-sm-inline">@UserSession.CurrentUser?.FullName</span>
                        @if (UserSession.IsAdmin)
                        {
                            <span class="badge bg-danger rounded-pill"><i class="bi bi-shield-check me-1"></i>Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-primary rounded-pill">TAG: @UserSession.UserTag</span>
                        }
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                        <li class="dropdown-header text-muted small">
                            <span class="d-block fw-bold text-dark">@UserSession.CurrentUser?.FullName</span>
                            <span>@UserSession.CurrentUser?.Email</span>
                            <span class="badge bg-info text-dark d-block mt-1">TAG: @UserSession.UserTag</span>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="tickets"><i class="bi bi-ticket-perforated me-2"></i>Tiket Saya</a></li>
                        @if (UserSession.IsAdmin)
                        {
                            <li><a class="dropdown-item" href="admin/users"><i class="bi bi-gear me-2"></i>Mailcow Sync Hub</a></li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item text-danger" @onclick="Logout"><i class="bi bi-box-arrow-right me-2"></i>Keluar</button></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- App Body -->
        <div class="container-fluid flex-grow-1">
            <div class="row min-vh-100">
                <!-- Sidebar -->
                <aside class="col-12 col-md-3 col-lg-2 bg-white border-end py-3 shadow-sm">
                    <NavMenu />
                </aside>

                <!-- Main Content Area -->
                <main class="col-12 col-md-9 col-lg-10 p-4 bg-light">
                    @Body
                </main>
            </div>
        </div>

        <!-- Footer -->
        <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
            <div class="container">
                <span>&copy; 2026 <strong>BaknusITCare</strong> - Layanan Terpadu IT SMK Bakti Nusantara 666. Powered by .NET 8, SQL Server & Microsoft Fluent UI.</span>
            </div>
        </footer>
    </div>
}
else
{
    <!-- Loading / Redirecting to Login -->
    <div class="min-vh-100 d-flex flex-column align-items-center justify-content-center bg-light">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p class="text-muted fw-semibold">Memeriksa autentikasi pengguna...</p>
    </div>
}

@code {
    private bool IsAuthPage
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
            if (relative.Contains('?')) relative = relative.Substring(0, relative.IndexOf('?'));
            return relative == "login" || relative.StartsWith("login/") || relative == "error";
        }
    }

    protected override void OnInitialized()
    {
        UserSession.OnSessionChanged += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
        EnforceAuthentication();
    }

    protected override void OnParametersSet()
    {
        EnforceAuthentication();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        EnforceAuthentication();
        StateHasChanged();
    }

    private void EnforceAuthentication()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
        if (path.Contains('?')) path = path.Substring(0, path.IndexOf('?'));

        if (!UserSession.IsLoggedIn && path != "login" && !path.StartsWith("login/") && path != "error")
        {
            Navigation.NavigateTo("login");
        }
        else if (UserSession.IsLoggedIn && (path == "login" || path.StartsWith("login/")))
        {
            Navigation.NavigateTo("");
        }
    }

    private void Logout()
    {
        UserSession.Logout();
        Navigation.NavigateTo("login");
    }

    public void Dispose()
    {
        UserSession.OnSessionChanged -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
