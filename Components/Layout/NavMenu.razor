@inject UserSessionService UserSession
@inject NavigationManager Navigation
@implements IDisposable

<div class="nav-menu p-3">
    <div class="mb-4 text-center text-lg-start">
        <span class="text-uppercase font-weight-bold text-muted small px-2">Menu Utama</span>
    </div>

    <ul class="nav nav-pills flex-column mb-auto gap-2">
        <li class="nav-item">
            <NavLink class="nav-link d-flex align-items-center py-2 px-3 rounded-3" href="" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2 me-3 fs-5"></i>
                <span class="fw-semibold">Dashboard Utama</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link d-flex align-items-center py-2 px-3 rounded-3 text-white bg-primary shadow-sm" href="tickets/create">
                <i class="bi bi-plus-circle-fill me-3 fs-5"></i>
                <span class="fw-bold">Buat Tiket Baru</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link d-flex align-items-center py-2 px-3 rounded-3" href="track">
                <i class="bi bi-search me-3 fs-5 text-info"></i>
                <span class="fw-semibold">Lacak Status Tiket</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link d-flex align-items-center py-2 px-3 rounded-3" href="tickets">
                <i class="bi bi-ticket-detailed me-3 fs-5"></i>
                <span class="fw-semibold">Daftar Tiket IT</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link d-flex align-items-center py-2 px-3 rounded-3" href="knowledge">
                <i class="bi bi-book-half me-3 fs-5"></i>
                <span class="fw-semibold">Pusat Bantuan (KB)</span>
            </NavLink>
        </li>

        @if (UserSession.IsAdmin)
        {
            <li class="nav-item mt-3 pt-3 border-top">
                <span class="text-uppercase font-weight-bold text-muted small px-2 d-block mb-2">Administrator</span>
                <NavLink class="nav-link d-flex align-items-center py-2 px-3 rounded-3" href="admin/users">
                    <i class="bi bi-people-fill me-3 fs-5 text-warning"></i>
                    <span class="fw-semibold">Kelola Tim IT (Guru & TU)</span>
                </NavLink>
            </li>
        }
    </ul>

    <div class="mt-4 pt-3 border-top">
        @if (UserSession.IsLoggedIn)
        {
            <div class="p-3 bg-light rounded-3 border mb-2">
                <div class="d-flex align-items-center mb-1">
                    <i class="bi bi-person-circle fs-4 me-2 text-primary"></i>
                    <div>
                        <div class="fw-bold text-truncate" style="max-width: 140px;">@UserSession.CurrentUser?.FullName</div>
                        <span class="badge bg-secondary" style="font-size: 0.65rem;">@UserSession.CurrentUser?.RoleName</span>
                    </div>
                </div>
                <div class="small text-muted text-truncate">@UserSession.CurrentUser?.Email</div>
            </div>
            <button class="btn btn-outline-danger btn-sm w-100 py-2 d-flex align-items-center justify-content-center" @onclick="HandleLogout">
                <i class="bi bi-box-arrow-right me-2"></i>Keluar Akun
            </button>
        }
        else
        {
            <NavLink class="btn btn-outline-primary btn-sm w-100 py-2 d-flex align-items-center justify-content-center" href="login">
                <i class="bi bi-shield-lock me-2"></i>Login Mailcow
            </NavLink>
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        UserSession.OnSessionChanged += StateHasChanged;
    }

    private void HandleLogout()
    {
        UserSession.Logout();
        Navigation.NavigateTo("login");
    }

    public void Dispose()
    {
        UserSession.OnSessionChanged -= StateHasChanged;
    }
}
